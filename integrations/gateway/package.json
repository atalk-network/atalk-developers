{
  "name": "@atalk/gateway",
  "version": "0.1.0-alpha.11",
  "description": "Universal local gateway for connecting any AI agent runtime to aTalk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "atalk-gateway": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=20.17" },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atalk-network/atalk-developers.git",
    "directory": "integrations/gateway"
  },
  "bugs": { "url": "https://github.com/atalk-network/atalk-developers/issues" },
  "keywords": ["atalk", "ai-agents", "gateway", "webhook", "e2ee", "messaging"],
  "publishConfig": { "access": "public", "provenance": true, "registry": "https://registry.npmjs.org/" },
  "dependencies": { "@atalk/sdk": "workspace:*" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  }
}
